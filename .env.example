# =============================================================
#  .env.example - copy to .env and fill in your values
#  NEVER commit .env to git
# =============================================================

# ── Fiverr Credentials ────────────────────────────────────
FIVERR_USERNAME=your_fiverr_username
FIVERR_EMAIL=your@email.com
FIVERR_PASSWORD=your_password_here

# ── Google SSO ────────────────────────────────────────────
# Used by challenge recovery: after wiping Fiverr site data we re-login via
# "Continue with Google". The Google cookies are deliberately preserved
# during the wipe, so this is normally a single click with no password.
# GOOGLE_EMAIL defaults to FIVERR_EMAIL when unset.
GOOGLE_EMAIL=your@gmail.com
# Only needed if Google falls back to a full sign-in form. An account with
# 2FA enabled cannot complete this headlessly - pre-authorise the browser
# profile instead (see scripts/local_auth.py).
GOOGLE_PASSWORD=

# ── Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY=your_fernet_key_here

# ── Proxy - Bright Data ──────────────────────────────────
# Format: host:port:username:password
PROXY_HOST=brd.superproxy.io
PROXY_PORT=22225
PROXY_USERNAME=brd-customer-XXXXX-zone-residential
PROXY_PASSWORD=your_proxy_password

# ── Proxy - Oxylabs (alternative) ───────────────────────
# PROXY_HOST=pr.oxylabs.io
# PROXY_PORT=7777
# PROXY_USERNAME=customer-XXXXX
# PROXY_PASSWORD=your_proxy_password

# ── AWS (optional - for CloudWatch logging) ──────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Alerts ────────────────────────────────────────────────
ALERT_EMAIL=your@email.com

# ── Runtime ───────────────────────────────────────────────
LOG_LEVEL=INFO
